# vim: set ft=gitconfig :
# -*- mode: gitconfig -*-

[include]
  path = ~/.config/git/private.gitconfig

# More involved commands live in ~/.local/bin/git-*
[alias]
  who = var GIT_COMMITTER_IDENT
  branch = branch --sort=-committerdate
  nvm="! git reset --soft HEAD~1"
  append="! git add . && git commit --amend"
  locals = "! git branch --format '%(refname:short) %(upstream:short)' | awk '{if (!$2) print $1;}'"
  browse = "!gh browse --branch $(git rev-parse --abbrev-ref HEAD)"
  wip = "! git add . && git commit -m'wip' --no-verify"
  root = "! git worktree list --porcelain | head -1 | cut -d' ' -f 2"
	fpush = push --force-with-lease --force-if-includes

[pull]
	rebase = true
[merge]
	conflictstyle = diff3
	tool = vimdiff
[rebase]
	autostash = true
	updateRefs = false
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[rerere]
	enabled = true
[help]
	autocorrect = prompt
[difftool]
    # Run the difftool immediately, don't ask 'are you sure' each time.
    prompt = false
[pager]
    # Use a pager if the difftool output is larger than one screenful,
    # consistent with the behaviour of `git diff`.
    difftool = true
[diff]
	algorithm = histogram
    # Set difftastic as the default difftool, so we don't need to specify
    # `-t difftastic` every time.
    tool = difftastic
[mergetool "vimdiff"]
	cmd = nvim -d $LOCAL $REMOTE $MERGED
